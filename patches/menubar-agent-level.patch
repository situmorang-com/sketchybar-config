--- a/src/bar_manager.c
+++ b/src/bar_manager.c
@@ -295,14 +295,30 @@
     if (level == TOPMOST_LEVEL_WINDOW) {
       bar_manager->window_level = kCGFloatingWindowLevel;
     } else if (level == TOPMOST_LEVEL_ALL) {
-      bar_manager->window_level = kCGStatusWindowLevel;
+      bar_manager->window_level = kCGStatusWindowLevel + 1; // above MenuBarAgent (macOS 27)
     }
   } else {
     bar_manager->window_level = kCGBackstopMenuLevel;
   }
 
-  bar_manager_reset(bar_manager);
+  // Re-level the existing windows in place instead of tearing every bar down
+  // and recreating it: with a few hundred items a reset keeps sketchybar busy
+  // for ~10s, which makes toggling topmost at runtime impractical. Hidden bars
+  // are re-levelled too (bar_order_item_windows skips them), so a bar that is
+  // hidden and lowered stops blocking the auto-hidden menu bar's hover reveal.
+  for (int i = 0; i < bar_manager->bar_count; i++) {
+    struct bar* bar = bar_manager->bars[i];
+    window_set_level(&bar->window, bar_manager->window_level);
+    for (int j = 0; j < bar_manager->bar_item_count; j++) {
+      struct bar_item* bar_item = bar_manager->bar_items[j];
+      if (bar_item->position == POSITION_POPUP) continue;
+      window_set_level(bar_item_get_window(bar_item, bar->adid),
+                       bar_manager->window_level);
+    }
+    bar_order_item_windows(bar);
+  }
   bar_manager->topmost = topmost;
+  bar_manager->bar_needs_update = true;
   return true;
 }
 
